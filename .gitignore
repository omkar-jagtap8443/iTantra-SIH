# ═══════════════════════════════════════════
# iTantra — Android .gitignore
# ═══════════════════════════════════════════

# ─── Built application files ───
*.apk
*.aar
*.ap_
*.aab

# ─── Files for the Dalvik VM ───
*.dex

# ─── Java class files ───
*.class

# ─── Generated files ───
bin/
gen/
out/
release/

# ─── Gradle files ───
.gradle/
build/
app/build/

# ─── Local configuration file (SDK path, etc.) ───
local.properties

# ─── Proguard folder generated by Eclipse ───
proguard/

# ─── Log files ───
*.log

# ─── Android Studio / IntelliJ ───
.idea/
*.iml
*.iws
*.ipr
.cxx/
.externalNativeBuild/
captures/

# ─── Keystore files (NEVER commit secrets) ───
*.jks
*.keystore

# ─── Google Services (secrets) ───
google-services.json

# ─── Mac OS ───
.DS_Store

# ─── Windows ───
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ─── Linux ───
*~

# ─── Node (if you add any tooling later) ───
node_modules/
npm-debug.log*

# ─── Crash reports ───
crashlytics-build.properties

# ═══════════════════════════════════════════
# NOTE: The following ARE committed on purpose:
#   - app/src/main/assets/  (Vosk language models)
#   - app/src/main/java/    (source code)
#   - app/src/main/res/     (resources)
#   - gradle/ and gradlew   (wrapper)
#   - *.gradle.kts          (build files)
# ═══════════════════════════════════════════